---
import "@fontsource-variable/montserrat";
import "@fontsource/open-sans/400.css";
import "@fontsource/open-sans/400-italic.css";
import "@fontsource/open-sans/700.css";
import "../styles/global.css";
import { getImage } from "astro:assets";
import avatar from "../assets/avatar.png";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = await getImage({ src: avatar, format: "jpg" });
const previewUrl = new URL(preview.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Prince Ravi Leow" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={previewUrl} />
    <meta property="og:image:width" content={String(preview.attributes.width)} />
    <meta property="og:image:height" content={String(preview.attributes.height)} />
    <meta property="og:image:alt" content="Prince Ravi Leow standing next to a research poster" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body>
    <main class="home">
      <slot />
    </main>
    <footer class="site-footer">
      © {new Date().getFullYear()} Prince Ravi Leow · Built with{" "}
      <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a>
    </footer>
  </body>
</html>
