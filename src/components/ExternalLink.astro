---
interface Props {
  href: string;
  icon?: string;
  class?: string;
}

const { href, icon, class: className } = Astro.props;
---

<a class={className} href={href} target="_blank" rel="noopener noreferrer">{icon && <span class="resource-icon" aria-hidden="true" set:html={icon.trim()} />}<slot /></a>
