---
import demo from "../assets/tracking_demo.mp4?url";
---

<figure class="hero-video">
  <video
    autoplay
    loop
    muted
    playsinline
    width="704"
    height="576"
    aria-label="Video clip tracked with PlayClass, with each subject annotated with coloured segmentation mask, bounding box and object id"
  >
    <source src={demo} type="video/mp4" />
  </video>
  <figcaption><slot /></figcaption>
</figure>

<script>
  const video = document.querySelector<HTMLVideoElement>(".hero-video video");
  if (video) {
    const gestures = ["touchend", "click", "keydown"];
    const start = () => video.play().catch(() => {});
    const stop = () => gestures.forEach((type) => document.removeEventListener(type, start));

    gestures.forEach((type) => document.addEventListener(type, start));
    video.addEventListener("playing", stop, { once: true });
    start();
  }
</script>
