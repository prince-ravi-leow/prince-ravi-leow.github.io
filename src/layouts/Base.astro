---
import "@fontsource-variable/quicksand";
import "@fontsource/open-sans/400.css";
import "@fontsource/open-sans/400-italic.css";
import "@fontsource/open-sans/700.css";
import "../styles/global.css";
import { getImage } from "astro:assets";
import avatar from "../assets/avatar.png";
import sunIcon from "bootstrap-icons/icons/sun.svg?raw";
import moonIcon from "bootstrap-icons/icons/moon.svg?raw";
import downIcon from "bootstrap-icons/icons/chevron-down.svg?raw";

interface Props {
  frontmatter: {
    title: string;
    description: string;
  };
}

const { title, description } = Astro.props.frontmatter;
const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = await getImage({ src: avatar, format: "jpg" });
const previewUrl = new URL(preview.src, Astro.site);
const siteName = "Prince Ravi Leow";
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: Astro.site,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={previewUrl} />
    <meta property="og:image:width" content={String(preview.attributes.width)} />
    <meta property="og:image:height" content={String(preview.attributes.height)} />
    <meta property="og:image:alt" content="Prince Ravi Leow standing next to a research poster" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <title>{title}</title>
    <script is:inline>
      try {
        if (localStorage.getItem("theme") === "dark") document.documentElement.dataset.theme = "dark";
      } catch {}
    </script>
  </head>
  <body>
    <button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Dark mode">
      <span aria-hidden="true" set:html={sunIcon.trim()} />
      <span class="track"><span class="thumb"></span></span>
      <span aria-hidden="true" set:html={moonIcon.trim()} />
    </button>
    <main class="home">
      <slot />
    </main>
    <footer class="site-footer">
      © {new Date().getFullYear()} Prince Ravi Leow · Built with{" "}
      <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a>
    </footer>
    <button class="scroll-hint" type="button" tabindex="-1" aria-hidden="true" set:html={downIcon.trim()} />
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const isDark = () => root.dataset.theme === "dark";
      const sync = () => toggle?.setAttribute("aria-checked", String(isDark()));

      toggle?.addEventListener("click", () => {
        const dark = !isDark();
        try {
          if (dark) {
            root.dataset.theme = "dark";
            localStorage.setItem("theme", "dark");
          } else {
            delete root.dataset.theme;
            localStorage.removeItem("theme");
          }
        } catch {}
        sync();
      });
      sync();

      const hint = document.querySelector(".scroll-hint");
      const mobile = window.matchMedia("(max-width: 700px)").matches;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const show = setTimeout(
        () => {
          if (window.scrollY < 8 && root.scrollHeight > window.innerHeight + 40) hint?.classList.add("visible");
        },
        mobile ? 1000 : 3000,
      );
      window.addEventListener(
        "scroll",
        () => {
          clearTimeout(show);
          hint?.classList.remove("visible");
        },
        { once: true, passive: true },
      );
      hint?.addEventListener("click", () => {
        const bio = document.querySelector(".home > p");
        const bioTop = bio ? bio.getBoundingClientRect().top + window.scrollY : 0;
        window.scrollTo({
          top: Math.max(bioTop - window.innerHeight * 0.45, window.innerHeight * 0.3),
          behavior: reducedMotion ? "auto" : "smooth",
        });
      });
    </script>
  </body>
</html>
